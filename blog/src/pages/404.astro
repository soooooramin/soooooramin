---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="404">
	<div class="flex flex-col items-center py-20 text-center">
		<p class="text-7xl font-bold text-slate-200">404</p>
		<h1 class="mt-4 text-2xl font-semibold text-slate-900">Page Not Found</h1>
		<p class="mt-2 text-sm text-slate-500">お探しのページは見つかりませんでした。</p>
		<a
			href="/"
			class="mt-8 rounded-md bg-sky-500 px-5 py-2 text-sm text-white shadow-sm transition-colors hover:bg-sky-600"
		>
			トップに戻る
		</a>
	</div>
</BaseLayout>
