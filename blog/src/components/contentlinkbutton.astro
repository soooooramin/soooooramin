---
const { post } = Astro.props;
---
<a
    href={`/${post.id}/`}
    class="group block rounded-lg border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md"
>
    <time datetime={post.data.date.toISOString()} class="text-xs text-slate-400">
        {post.data.date.toLocaleDateString('ja-JP')}
    </time>
    <h2 class="mt-1 text-lg font-semibold text-slate-900 group-hover:text-sky-600">{post.data.title}</h2>
    <p class="mt-1 text-sm text-slate-500">{post.data.description}</p>
</a>
