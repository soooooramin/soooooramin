---
import BaseLayout from './BaseLayout.astro'

const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
    <article class="select-none">
        <header class="mb-8 border-b border-slate-200 pb-6">
            <h1 class="mt-2 text-3xl font-bold text-slate-900">{frontmatter.title}</h1>
            <p class="mt-2 text-slate-500">{frontmatter.description}</p>
            <time datetime={frontmatter.date.toISOString()} class="text-sm text-slate-400">
                投稿日: {frontmatter.date.toLocaleDateString('ja-JP')}
            </time>
        </header>
        <div class="prose prose-slate max-w-none prose-a:text-sky-600">
            <slot />
        </div>
    </article>
</BaseLayout>
